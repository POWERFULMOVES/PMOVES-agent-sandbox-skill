# --- Which cluster? Decide this FIRST. ---
# Leaving BOTH of the next two unset means sandboxes are created on hosted
# e2b.dev and billed to E2B_API_KEY below. That is silent -- no error, no
# warning. If you are self-hosted, set one of them.

# Self-hosted cluster: bare domain, no scheme, no trailing slash.
#   correct:   E2B_DOMAIN=e2b.corp.com
#   WRONG:     E2B_DOMAIN=https://e2b.corp.com/
# It is concatenated into <port>-<sandbox_id>.<domain>, so a scheme corrupts the host.
# E2B_DOMAIN=

# Bare-metal / single local node instead of a domain-fronted cluster.
# E2B_API_URL=http://localhost:3000

# Overrides the computed sandbox URL wholesale. Rarely needed.
# NOTE: the bare-metal runbook also mentions E2B_ENVD_API_URL -- the SDK does
# NOT read that variable. Use E2B_SANDBOX_URL.
# E2B_SANDBOX_URL=

# --- Credentials ---
# A key is only valid for the cluster that ISSUED it. A hosted e2b.dev key
# will 401 against your own cluster, and vice versa.
#   hosted            -> https://e2b.dev/docs
#   self-hosted       -> `make prep-cluster` (initial user/team), `make seed-db` for more
#   bare-metal/local  -> packages/local-dev/seed-local-database.go prints both
E2B_API_KEY=

# User-scoped token. Template builds may require this rather than E2B_API_KEY.
# E2B_ACCESS_TOKEN=

ELEVENLABS_API_KEY=
